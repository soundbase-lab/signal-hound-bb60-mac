{
  "manifestVersion": 1,
  "id": "signal-hound-bb60",
  "name": "Signal Hound BB60",
  "version": "1.1.0",
  "license": "BUSL-1.1",
  "platforms": [
    "darwin-arm64"
  ],
  "repository": "https://github.com/soundbase-lab/signal-hound-bb60-mac",
  "maintainers": [
    {
      "name": "Matt Dale",
      "email": "matt.dale@soundbase.app"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "template": {
    "name": "soundbase-plugin-template",
    "version": "1.0.11"
  },
  "products": [
    {
      "deviceTypeId": "plugin:signal-hound-bb60/bb60c",
      "manufacturer": {
        "id": "signal-hound",
        "name": "Signal Hound"
      },
      "model": {
        "id": "bb60c",
        "name": "BB60C",
        "displayName": "Signal Hound BB60C"
      },
      "family": {
        "id": "signal-hound-bb60",
        "name": "Signal Hound BB60"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    }
  ],
  "stateKeys": [],
  "deviceConfigFields": [
    {
      "id": "serial",
      "type": "textinput",
      "label": "Serial number",
      "help": "Leave empty to use the first BB60 found."
    }
  ],
  "pluginConfigFields": [
    {
      "id": "libraryPath",
      "type": "textinput",
      "label": "Signal Hound library",
      "help": "Only if libbb_api.dylib is not in the standard location."
    }
  ]
}
